# Backend
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./kisan_hita.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175
# Each selector is independent. The crop evidence catalog is intentionally empty until verified records are approved.
WEATHER_PROVIDER=mock
CROP_PROVIDER=evidence-catalog
DISEASE_PROVIDER=mock
MARKET_PROVIDER=mock
LLM_PROVIDER=mock
SPEECH_TO_TEXT_PROVIDER=mock
TEXT_TO_SPEECH_PROVIDER=mock
# Live voice activation is explicit and backend-only. To enable both services,
# set GNANI_LIVE_API_ENABLED=true, select prisma-live and timbre-live above,
# and provide your own key in GNANI_API_KEY. Never put the key in frontend env.
GNANI_LIVE_API_ENABLED=false
GNANI_API_KEY=
MAX_UPLOAD_BYTES=5242880
